# Normaliza fim de linha: LF no repositório, nativo no working directory
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.md      text
*.yaml    text
*.yml     text
*.json    text
*.txt     text
*.resx    text

# Binários — nunca converter
*.pdf     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.dll     binary
*.exe     binary
